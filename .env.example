APP_DOMAIN=openg7.org
LETSENCRYPT_EMAIL=admin@example.com
TRAEFIK_DASHBOARD_BIND=127.0.0.1:8081
CADVISOR_BIND=127.0.0.1:8082
VPS_HOST=your-vps-host.example.com
VPS_APP_DIR=/opt/openg7-funding-platform
# Public identity pin for the optional VPS agent; required before SSH execution.
# Set only after independent verification through a trusted VPS console.
PLA_SSH_HOST_FINGERPRINT=

WEB_IMAGE=openg7-funding-web:local
API_IMAGE=openg7-funding-api:local

# Private deployment resource names; defaults preserve existing installations.
# Recovery uses a new, dedicated project and names for every volume/network.
POSTGRES_VOLUME_NAME=openg7-postgres-data
SPONSOR_LOGOS_VOLUME_NAME=openg7-sponsor-logos
OPENG7_EDGE_NETWORK_NAME=openg7-edge
OPENG7_DATA_NETWORK_NAME=openg7-data

FUNDING_PLATFORM_ENV=production
FUNDING_PLATFORM_API_BASE_URL=https://openg7.org/api
FUNDING_PUBLIC_BASE_URL=https://openg7.org
FUNDING_ALLOWED_ORIGINS=https://openg7.org,https://www.openg7.org
FUNDING_ALLOWED_AMOUNTS=5,10,25,50
FUNDING_BUSINESS_SPONSORSHIP_ENABLED=false
FUNDING_API_PORT=3333
FUNDING_PROJECT_ID=openg7
# Local token mode only: independent random token >=32 characters; blank in production.
FUNDING_ADMIN_TOKEN=
FUNDING_ADMIN_SESSION_SECRET=replace_with_a_different_long_random_session_secret
# Private API encryption key: generate 32 random bytes as standard base64.
# Required in production; preserve an independent protected recovery copy.
FUNDING_PRIVATE_DATA_ENCRYPTION_KEY=
FUNDING_ADMIN_SESSION_TTL_MINUTES=60
FUNDING_SPONSOR_LOGO_STORAGE_DIR=/app/var/sponsor-logos
FUNDING_SPONSOR_LOGO_MAX_BYTES=524288
# Private server limits: file size must be 1..8388608 bytes (proxy envelope: 9 MiB).
FUNDING_SPONSOR_MEDIA_MAX_BYTES=8388608
FUNDING_SPONSOR_MEDIA_MAX_SUPPORTING_IMAGES=3
FUNDING_SPONSORSHIP_FOLLOWUP_TOKEN_TTL_DAYS=30
FUNDING_RATE_LIMIT_WINDOW_MS=60000
# Private server setting: 0 for direct API; 1 only behind the isolated Compose proxy.
FUNDING_TRUSTED_PROXY_HOPS=1
FUNDING_PUBLIC_WRITE_RATE_LIMIT_MAX=60
FUNDING_SPONSORSHIP_FOLLOWUP_RATE_LIMIT_MAX=60
FUNDING_REFERENCE_LOOKUP_RATE_LIMIT_MAX=30
FUNDING_REFERENCE_RECOVERY_RATE_LIMIT_MAX=10
FUNDING_ADMIN_RATE_LIMIT_MAX=120
FUNDING_ADMIN_NOTIFICATION_EMAIL=admin@example.com
# Private server settings. Payment activity/toasts persist; email delivery is opt-in.
FUNDING_CONTRIBUTION_EMAIL_ENABLED=false
# SMS has no live adapter. Mock is local-only and rejected in production.
FUNDING_CONTRIBUTION_SMS_MODE=disabled
FUNDING_CONTRIBUTION_SMS_MOCK_URL=http://127.0.0.1:4242/__test__/sms
# Private, isolated acceptance only: local Stripe simulator + test key required.
STRIPE_SIMULATED_CHECKOUT_ENABLED=false
FUNDING_ADMIN_REVIEW_REMINDER_ENABLED=true
FUNDING_ADMIN_REVIEW_REMINDER_MIN_AGE_DAYS=1
FUNDING_ADMIN_REVIEW_REMINDER_POLL_INTERVAL_MS=3600000
FUNDING_ADMIN_REVIEW_REMINDER_MAX_ITEMS=5
FUNDING_EMAIL_QUEUE_POLL_INTERVAL_MS=30000
# Private server switch; false pauses background claims without changing the queue.
FUNDING_EMAIL_WORKER_ENABLED=true
FUNDING_EMAIL_QUEUE_BATCH_SIZE=10

# Read-only admin AI assistant (iteration 1).
# The deterministic attention summary always works; these only affect the
# conversational endpoint. Leave disabled to ship without any model provider.
# Provider "mock" runs a deterministic in-process router (no external calls).
# No live external provider is wired yet; ADMIN_AI_API_KEY is reserved and is
# never exposed to the browser or written to logs.
ADMIN_AI_ASSISTANT_ENABLED=false
ADMIN_AI_PROVIDER=
ADMIN_AI_MODEL=
ADMIN_AI_API_KEY=
ADMIN_AI_MAX_TOOL_CALLS=6
ADMIN_AI_TIMEOUT_MS=15000
ADMIN_AI_MAX_MESSAGE_LENGTH=2000
ADMIN_AI_MAX_ITEMS_PER_TOOL=25

# Transactional email
SMTP_ENABLED=false
SMTP_HOST=mail.papamail.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=notify@openg7.org
SMTP_PASSWORD=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
MAIL_FROM_NAME=OpenG7
MAIL_FROM_ADDRESS=notify@openg7.org
MAIL_REPLY_TO_NAME=OpenG7
MAIL_REPLY_TO_ADDRESS=contact@openg7.org

FUNDING_SPONSORSHIP_INVOICE_PREFIX=OG7-CMD
FUNDING_INVOICE_ISSUER_NAME=OpenG7
FUNDING_INVOICE_ISSUER_EMAIL=contact@openg7.org
FUNDING_INVOICE_ISSUER_ADDRESS=
FUNDING_INVOICE_TAX_ID=
FUNDING_SPONSORSHIP_INVOICE_TAX_LABEL=Taxes non calculees par la plateforme
FUNDING_SPONSORSHIP_INVOICE_LEGAL_NOTE=Facture de commandite descriptive. Ce document ne constitue pas un recu officiel de don de bienfaisance.
FUNDING_SPONSORSHIP_CREDIT_NOTE_PREFIX=OG7-AV
FUNDING_SPONSORSHIP_CREDIT_NOTE_LEGAL_NOTE=Avoir de commandite lie a un remboursement Stripe. Ce document reduit la facture associee du montant indique et ne constitue pas un recu officiel de don de bienfaisance.
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

SPONSOR_MEDIA_STORAGE_DRIVER=ovh-s3

SPONSOR_MEDIA_REGION=bhs
SPONSOR_MEDIA_ENDPOINT=https://s3.bhs.io.cloud.ovh.net

SPONSOR_MEDIA_PUBLIC_BUCKET=openg7-funding-sponsor-media-public-prod
SPONSOR_MEDIA_PUBLIC_BASE_URL=https://openg7-funding-sponsor-media-public-prod.s3.bhs.io.cloud.ovh.net

SPONSOR_MEDIA_PRIVATE_BUCKET=openg7-funding-sponsor-media-private-prod
SPONSOR_MEDIA_PRIVATE_BASE_URL=https://openg7-funding-sponsor-media-private-prod.s3.bhs.io.cloud.ovh.net

OVH_S3_ACCESS_KEY_ID=
OVH_S3_SECRET_ACCESS_KEY=

# Social publication automation. Keep disabled until app/page permissions and
# long-lived tokens are configured outside the repository.
SOCIAL_PUBLICATION_MODE=disabled
# Private, optional local receiver; only in development/test with mode=mock.
# Example: http://127.0.0.1:4242/__test__/social (never a public/provider URL).
SOCIAL_PUBLICATION_MOCK_URL=
# Initial default only; an explicit admin On / Off choice persists in PostgreSQL.
SOCIAL_PUBLICATION_WORKER_ENABLED=false
SOCIAL_PUBLICATION_OPENG7_FACEBOOK_ACCOUNT_ID=
SOCIAL_PUBLICATION_OPENG7_FACEBOOK_ACCESS_TOKEN=
SOCIAL_PUBLICATION_OPENG7_FACEBOOK_EXPIRES_AT=
SOCIAL_PUBLICATION_OPENG7_LINKEDIN_ACCOUNT_ID=
SOCIAL_PUBLICATION_OPENG7_LINKEDIN_ACCESS_TOKEN=
SOCIAL_PUBLICATION_OPENG7_LINKEDIN_EXPIRES_AT=
SOCIAL_PUBLICATION_OPENG20_FACEBOOK_ACCOUNT_ID=
SOCIAL_PUBLICATION_OPENG20_FACEBOOK_ACCESS_TOKEN=
SOCIAL_PUBLICATION_OPENG20_FACEBOOK_EXPIRES_AT=
SOCIAL_PUBLICATION_OPENG20_LINKEDIN_ACCOUNT_ID=
SOCIAL_PUBLICATION_OPENG20_LINKEDIN_ACCESS_TOKEN=
SOCIAL_PUBLICATION_OPENG20_LINKEDIN_EXPIRES_AT=
SOCIAL_PUBLICATION_FACEBOOK_GRAPH_BASE_URL=https://graph.facebook.com/v25.0
SOCIAL_PUBLICATION_FACEBOOK_PAGE_ID=
SOCIAL_PUBLICATION_FACEBOOK_PAGE_ACCESS_TOKEN=
SOCIAL_PUBLICATION_LINKEDIN_API_BASE_URL=https://api.linkedin.com/rest
SOCIAL_PUBLICATION_LINKEDIN_ORGANIZATION_ID=
SOCIAL_PUBLICATION_LINKEDIN_ACCESS_TOKEN=
SOCIAL_PUBLICATION_LINKEDIN_VERSION=202606

# Private PostgreSQL is required for real Checkout and production administration.
# Absent DATABASE_URL is limited to compatible development transparency paths.
# Start with: docker compose --profile database up -d postgres
# POSTGRES_DB=openg7_funding
# Bootstrap/migration credentials stay on the host and PostgreSQL container only.
# Preserve POSTGRES_USER for existing installations; never give it to the API.
# POSTGRES_USER=openg7_funding_owner
# POSTGRES_PASSWORD=replace_with_a_long_random_secret
# Dedicated runtime role, provisioned separately after migrations.
# FUNDING_DATABASE_RUNTIME_USER=openg7_funding_api
# FUNDING_DATABASE_RUNTIME_PASSWORD=replace_with_a_different_long_random_secret
# DATABASE_URL=postgres://openg7_funding_api:replace_with_a_different_long_random_secret@postgres:5432/openg7_funding

BACKUP_DIR=./backups
# Public age recipient for FULL encrypted backups (config, DB and media).
# Generate on a trusted recovery workstation; its private identity stays off VPS.
FUNDING_FULL_BACKUP_AGE_RECIPIENT=
# Optional database backup service: use database-backup.env.example to prepare
# a SEPARATE .env.backup. Never place its credentials in this API environment.
# Configuration stays disabled until the separate worker is explicitly started.
FUNDING_BACKUP_ENV_FILE=.env.backup
# OIDC is mandatory in production; local development/test may explicitly use token.
# OIDC requires migration 020, a same-origin
# Web/API deployment, and MFA assertions in signed ID tokens. Never enable an
# unconfigured issuer. Subject values come from the identity provider, not email.
FUNDING_ADMIN_AUTH_MODE=oidc
FUNDING_ADMIN_OIDC_ISSUER=
FUNDING_ADMIN_OIDC_CLIENT_ID=
FUNDING_ADMIN_OIDC_CLIENT_SECRET=
FUNDING_ADMIN_OIDC_OWNER_SUBJECTS=
# Comma-separated ACR values that your provider guarantees mean MFA.
# Without these, the signed amr claim must contain mfa.
FUNDING_ADMIN_OIDC_MFA_ACR=

# Optional self-hosted Keycloak provider. Production: docs/operations/keycloak-vps.md.
# Windows/Docker development HTTPS: docs/operations/keycloak-local.md.
# Public hostname (DNS only); private activation switch and bootstrap username.
FUNDING_KEYCLOAK_ENABLED=false
FUNDING_KEYCLOAK_HOSTNAME=auth.openg7.org
FUNDING_KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
# Private secrets: independent random values of at least 32 characters, no defaults.
# Only identity containers receive these; never forward them to the API or Web.
FUNDING_KEYCLOAK_DB_PASSWORD=
FUNDING_KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=
# With the overlay, configure the existing OIDC settings above:
# FUNDING_ADMIN_OIDC_ISSUER=https://auth.openg7.org/realms/openg7
# FUNDING_ADMIN_OIDC_CLIENT_ID=openg7-funding-admin
# FUNDING_ADMIN_OIDC_CLIENT_SECRET=<independent private secret, at least 32 chars>
# The imported password + OTP flow emits signed amr=mfa; leave MFA_ACR empty.

# Independent operations watcher; explicitly opt into deploy/check/rollback management.
FUNDING_OPERATIONS_WATCHER_ENABLED=false
# Receiver: HTTPS, validates signature and deduplicates X-OpenG7-Event-Id.
FUNDING_OPERATIONS_WEBHOOK_URL=
FUNDING_OPERATIONS_WEBHOOK_SECRET=
