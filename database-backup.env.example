# Copy to a protected .env.backup, separate from the API's .env.
# Public settings: daily UTC backups, protection for at least 30 days.
FUNDING_BACKUP_ENABLED=false
FUNDING_BACKUP_NAMESPACE=
FUNDING_BACKUP_AGE_RECIPIENT=
FUNDING_BACKUP_S3_ENDPOINT=
FUNDING_BACKUP_S3_REGION=
FUNDING_BACKUP_S3_BUCKET=
# Absolute private staging directory for a worker outside Compose.
FUNDING_BACKUP_DIRECTORY=
# Private: dedicated DB role and S3 identity. No delete/bypass-retention rights.
# PostgreSQL must be the API's own database. Use TLS verify-full remotely;
# sslmode=disable is only for the existing private Compose data network.
FUNDING_BACKUP_DATABASE_URL=
FUNDING_BACKUP_S3_ACCESS_KEY_ID=
FUNDING_BACKUP_S3_SECRET_ACCESS_KEY=
